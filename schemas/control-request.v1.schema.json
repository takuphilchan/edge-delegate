{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit single-endpoint control request",
  "description": "Structural envelope only. Catalog validation, target binding, policy and runtime authorization are still required.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "target", "action", "parameters", "catalog_sha256"],
  "properties": {
    "schema_version": {"const": "edge-control-request.v1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "catalog_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "endpoint_id", "binding_sha256"],
      "properties": {
        "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "endpoint_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "binding_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "action": {
      "type": "string", "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "parameters": {
      "type": "object", "maxProperties": 8,
      "propertyNames": {"minLength": 1, "maxLength": 64},
      "additionalProperties": {
        "oneOf": [
          {"type": "boolean"},
          {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807}
        ]
      }
    }
  }
}
