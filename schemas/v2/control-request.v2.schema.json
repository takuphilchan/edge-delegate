{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Edge Delegate control request v2 (experimental)",
  "description": "Immediate request foundation. Runtime additionally rejects duplicate keys, frames >65536 bytes, authority mismatch, and UTF-8 text >4096 bytes. Does not authorize execution.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "edge-control-request.v2"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "authority_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "budget_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "action"
            },
            "target": {
              "$ref": "#/$defs/target"
            },
            "action": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "parameters": {
              "$ref": "#/$defs/parameters"
            }
          },
          "required": [
            "kind",
            "target",
            "action",
            "parameters"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "maxLength": 4096,
              "not": {
                "pattern": "\\u0000"
              },
              "description": "Runtime additionally enforces <=4096 UTF-8 bytes.",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "authority_id",
    "budget_ms",
    "input"
  ],
  "additionalProperties": false,
  "$defs": {
    "target": {
      "type": "object",
      "properties": {
        "authority_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "endpoint_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "registration_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "observation_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "catalog_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "authority_id",
        "endpoint_id",
        "registration_generation",
        "observation_generation",
        "catalog_sha256"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9._:-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    },
    "parameter": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "string"
            },
            "value": {
              "type": "string",
              "maxLength": 4096,
              "not": {
                "pattern": "\\u0000"
              },
              "description": "Runtime additionally enforces <=4096 UTF-8 bytes."
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "enum"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "resource"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "decimal"
            },
            "value": {
              "type": "string",
              "maxLength": 32,
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "not": {
                "const": "-0"
              }
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            }
          },
          "required": [
            "type",
            "value",
            "unit"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
